generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}


enum EvaluationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  role          String    @default("student") @db.VarChar(50)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
  
  student       Student?
  admin         Admin?
  questions     Question[]
  templates     TestTemplate[]

  @@map("users")
}

model Student {
  id                    String    @id @default(uuid()) @db.Uuid
  user_id               String    @unique @db.Uuid
  full_name             String?   @db.VarChar(255)
  phone                 String?   @db.VarChar(20)
  college               String?   @db.VarChar(255)
  usn                   String?   @unique @db.VarChar(50)
  branch_name           String?   @db.VarChar(255)
  profile_completed     Boolean   @default(false)
  camera_permission     Boolean   @default(false)
  microphone_permission Boolean   @default(false)
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  updated_at            DateTime  @default(now()) @db.Timestamp(6)

  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tests                 Test[]
  ai_evaluations        AIEvaluation[]

  @@map("students")
}

model Admin {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @unique @db.Uuid
  full_name   String?   @db.VarChar(255)
  department  String?   @db.VarChar(255)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Question {
  id                 String    @id @default(uuid()) @db.Uuid
  question_text      String
  type               String    @default("mcq") @db.VarChar(50)
  options_json       Json?
  correct_answer     String?
  explanation        String?
  time_limit_seconds Int?      @default(60)
  points             Int?      @default(10)
  is_published       Boolean   @default(false)
  weight             Int?      @default(1)
  expected_duration  Int?      @default(5)
  is_required        Boolean?  @default(true)
  display_order      Int?      @default(0)
  section            String?   @db.VarChar(50)
  section_order      Int?      @default(0)
  question_order     Int?      @default(0)
  created_by         String    @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @default(now()) @db.Timestamp(6)

  creator            User      @relation(fields: [created_by], references: [id])
  test_questions     TestQuestion[]
  test_responses     TestResponse[]
  ai_evaluations     AIEvaluation[]

  @@map("questions")
}

model Test {
  id               String    @id @default(uuid()) @db.Uuid
  student_id       String    @db.Uuid
  start_time       DateTime? @db.Timestamp(6)
  end_time         DateTime? @db.Timestamp(6)
  status           String?   @default("not_started") @db.VarChar(50)
  total_duration   Int
  current_duration Int?      @default(0)
  violations_count Int?      @default(0)
  score            Decimal?  @db.Decimal(5, 2)
  is_completed     Boolean?  @default(false)
  results_published Boolean  @default(false)
  min_attempt_percentage Int?  @default(60)
  min_attempt_enabled    Boolean? @default(true)
  template_id      String?   @db.Uuid
  round            Int       @default(1)
  title            String?   @db.VarChar(255)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @db.Timestamp(6)

  student          Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  template         TestTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  test_questions   TestQuestion[]
  test_responses   TestResponse[]
  violations       Violation[]
  analytics        TestAnalytics?
  ai_evaluations   AIEvaluation[]

  @@index([template_id])
  @@index([round])
  @@index([student_id, round])
  @@map("tests")
}

model TestQuestion {
  id              String    @id @default(uuid()) @db.Uuid
  test_id         String    @db.Uuid
  question_id     String    @db.Uuid
  sequence_number Int
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  test            Test      @relation(fields: [test_id], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [question_id], references: [id])

  @@unique([test_id, question_id])
  @@map("test_questions")
}

model TestResponse {
  id             String    @id @default(uuid()) @db.Uuid
  test_id        String    @db.Uuid
  question_id    String    @db.Uuid
  student_answer String?
  is_correct     Boolean?
  points_earned       Decimal?  @default(0) @db.Decimal(5, 2)
  ai_evaluation_json  Json?
  auto_saved_at       DateTime? @db.Timestamp(6)
  submitted_at   DateTime? @db.Timestamp(6)
  started_at     DateTime? @db.Timestamp(6)
  word_count     Int?      @default(0)
  character_count Int?     @default(0)
  evaluation_status  EvaluationStatus? @default(PENDING)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @default(now()) @db.Timestamp(6)

  test           Test      @relation(fields: [test_id], references: [id], onDelete: Cascade)
  question       Question  @relation(fields: [question_id], references: [id])
  ai_evaluation  AIEvaluation?

  @@map("test_responses")
  @@unique([test_id, question_id], name: "test_question_unique")
}

model Violation {
  id             String    @id @default(uuid()) @db.Uuid
  test_id        String    @db.Uuid
  violation_type String    @db.VarChar(100)
  description    String?
  severity       String?   @default("warning") @db.VarChar(50)
  timestamp      DateTime? @default(now()) @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)

  test           Test      @relation(fields: [test_id], references: [id], onDelete: Cascade)

  @@map("violations")

}

model TestTemplate {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(255)
  description     String?
  total_questions Int
  total_duration  Int
  created_by      String    @db.Uuid
  is_active       Boolean?  @default(true)
  min_attempt_percentage Int? @default(60)
  min_attempt_enabled    Boolean? @default(true)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @default(now()) @db.Timestamp(6)

  creator         User      @relation(fields: [created_by], references: [id])
  tests           Test[]

  @@map("test_templates")
}

model TestAnalytics {
  id                String    @id @default(uuid()) @db.Uuid
  test_id           String    @unique @db.Uuid
  total_questions   Int?
  correct_answers   Int?
  incorrect_answers Int?
  unanswered        Int?
  total_score       Decimal?  @db.Decimal(5, 2)
  time_taken        Int?
  violations_count  Int?      @default(0)
  percentile        Decimal?  @db.Decimal(5, 2)
  overall_ai_marks  Decimal?  @db.Decimal(5, 2)
  overall_percentage Decimal? @db.Decimal(5, 2)
  section_totals    Json?
  created_at        DateTime  @default(now()) @db.Timestamp(6)

  test              Test      @relation(fields: [test_id], references: [id], onDelete: Cascade)

  @@map("test_analytics")
}

model AIEvaluation {
  id                 String    @id @default(uuid()) @db.Uuid
  test_id            String    @db.Uuid
  student_id         String    @db.Uuid
  question_id        String    @db.Uuid
  section            String?   @db.VarChar(50)
  question_type      String    @default("mcq") @db.VarChar(50)
  obtained_marks     Decimal?  @db.Decimal(10, 2)
  maximum_marks      Decimal?  @db.Decimal(5, 2)
  feedback           String?
  strengths          String[]
  improvements       String[]
  evaluation_status  EvaluationStatus @default(PENDING)
  model_used         String?   @db.VarChar(100)
  raw_response       Json?
  evaluated_at       DateTime? @db.Timestamp(6)
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @default(now()) @db.Timestamp(6)

  test               Test      @relation(fields: [test_id], references: [id], onDelete: Cascade)
  student            Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  question           Question  @relation(fields: [question_id], references: [id])
  
  test_response_id   String    @unique @db.Uuid
  test_response      TestResponse @relation(fields: [test_response_id], references: [id], onDelete: Cascade)

  @@map("ai_evaluations")
 
}


